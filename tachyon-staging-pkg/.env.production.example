COMPOSE_PROJECT_NAME=tachyon-production

SERVER_PORT=8080
FRONTEND_PORT=3000
SERVER_HOST=0.0.0.0
VERSION=latest

POSTGRES_USER=tachyon
POSTGRES_PASSWORD=<GENERATE_WITH_openssl_rand_base64_32>
POSTGRES_DB=tachyon
POSTGRES_PORT=5432

REDIS_PORT=6379

JWT_SECRET=<GENERATE_WITH_openssl_rand_base64_64>
JWT_EXPIRATION=86400

CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

RUST_LOG=warn
LOG_FORMAT=json

DATABASE_PATH=/data/tachyon.db
SEARCH_INDEX_PATH=/data/search

RENDERER_CACHE_SIZE=1000
RENDERER_ENABLE_MATH=true
RENDERER_ENABLE_SYNTAX=true

METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true

MAX_UPLOAD_SIZE=10485760
PASSWORD_HASH_COST=12

ALERT_EMAIL=admin@your-domain.com
