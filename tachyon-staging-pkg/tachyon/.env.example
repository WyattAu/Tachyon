# =============================================================================
# Tachyon Configuration
# =============================================================================
# Copy this file to .env and customize for your environment.
# All variables have sensible defaults — only override what you need.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
TACHYON_HOST=127.0.0.1
TACHYON_PORT=3000
RUST_LOG=info,tachyon_server=debug

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://tachyon:tachyon@localhost:5432/tachyon
# Or for SQLite:
# TACHYON_DATABASE_PATH=./data/tachyon.db

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# REQUIRED: Change this in production!
# For secret rotation, use TACHYON_JWT_SECRETS with comma-separated values
# (first = current signing key, rest = rotated keys still valid for validation)
TACHYON_JWT_SECRET=change-me-to-a-random-64-char-string
# Or use the multi-secret format for rotation:
# TACHYON_JWT_SECRETS=your-current-secret,previous-secret-for-rotation
JWT_EXPIRATION=3600
GUEST_LOGIN_ENABLED=false
PUBLIC_NOTES_ENABLED=false

# -----------------------------------------------------------------------------
# OAuth2 (optional)
# -----------------------------------------------------------------------------
TACHYON_OAUTH2_ENABLED=false
TACHYON_GOOGLE_CLIENT_ID=
TACHYON_GOOGLE_CLIENT_SECRET=
TACHYON_GITHUB_CLIENT_ID=
TACHYON_GITHUB_CLIENT_SECRET=
TACHYON_OAUTH2_REDIRECT_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
TACHYON_RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Redis (optional — enables distributed rate limiting)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
TACHYON_SITE_TITLE=Tachyon
TACHYON_SITE_DESCRIPTION=A collaborative wiki
TACHYON_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Email / SMTP (optional)
# -----------------------------------------------------------------------------
# TACHYON_SMTP_URL=smtp://user:pass@smtp.example.com:587
# TACHYON_SMTP_FROM=noreply@tachyon.app
# TACHYON_EMAIL_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# TrueLayer Billing (optional)
# -----------------------------------------------------------------------------
TRUELAYER_ENABLED=false
# TRUELAYER_CLIENT_ID=
# TRUELAYER_CLIENT_SECRET=
# TRUELAYER_ENV=sandbox
# TRUELAYER_MERCHANT_ACCOUNT_ID=
# TRUELAYER_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Security Headers
# -----------------------------------------------------------------------------
TACHYON_SECURITY_DEVELOPMENT=true
TACHYON_SECURITY_CSP_ENABLED=true
TACHYON_SECURITY_HSTS_ENABLED=true
# TACHYON_SECURITY_CSP_CUSTOM=
# TACHYON_SECURITY_FRAME_ANCESTORS='none'
# TACHYON_SECURITY_PERMISSIONS_POLICY=
# TACHYON_SECURITY_TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# TLS (optional)
# -----------------------------------------------------------------------------
TACHYON_TLS_ENABLED=false
# TACHYON_TLS_CERT_PATH=/path/to/cert.pem
# TACHYON_TLS_KEY_PATH=/path/to/key.pem

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
TACHYON_FILES_ROOT=./uploads
# Storage backend: "local" or "s3"
# TACHYON_STORAGE_BACKEND=local
# TACHYON_STORAGE_S3_BUCKET=
# TACHYON_STORAGE_S3_REGION=us-east-1
# TACHYON_STORAGE_S3_ENDPOINT=
# TACHYON_STORAGE_S3_ACCESS_KEY=
# TACHYON_STORAGE_S3_SECRET_KEY=

# -----------------------------------------------------------------------------
# Admin (first-run setup)
# -----------------------------------------------------------------------------
TACHYON_ADMIN_USERNAME=admin
# TACHYON_ADMIN_PASSWORD=  # Leave empty for auto-generated password
# TACHYON_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# LOG_FORMAT=json  # "text" for human-readable, "json" for structured
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
# TEST_DATABASE_URL=postgres://tachyon_test:tachyon_test@localhost:5433/tachyon_test
