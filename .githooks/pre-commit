#!/usr/bin/env bash
#
# Tachyon pre-commit hook
# Enforces strict code quality gates before any commit is created.
#
# Gates:
#   1. cargo fmt --check (all crates)
#   2. cargo clippy -D warnings (all non-heavy crates)
#   3. cargo test --lib (library unit tests; integration in CI)
#   4. Secret detection
#   5. Debug artifact detection
#   6. Emoji detection in documentation
#   7. Forbidden patterns (Box::leak, unwrap in prod paths, todo!/unimplemented!)
#   8. Stale .specs/ reference detection
#
# Install: git config core.hooksPath .githooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
WORKSPACE_DIR="${REPO_ROOT}/tachyon"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}[PASS]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
fail()  { echo -e "${RED}[FAIL]${NC} $*"; }

PASS=true

# Skip checks if no relevant files were modified
RUST_CHANGED="$(git diff --cached --name-only --diff-filter=ACM | grep -cE '\.rs$|Cargo\.toml|Cargo\.lock' || true)"
DOC_CHANGED="$(git diff --cached --name-only --diff-filter=ACM | grep -cE '\.md$' || true)"

if [ "$RUST_CHANGED" -eq 0 ] && [ "$DOC_CHANGED" -eq 0 ]; then
    info "No Rust or documentation files staged. Skipping checks."
    exit 0
fi

if [ "$RUST_CHANGED" -eq 0 ]; then
    # Only doc changes -- skip cargo checks
    info "No Rust files staged. Skipping cargo checks."
else
    # ---- 1. Formatting ----
    info "Checking formatting (cargo fmt)..."
    if ! cargo fmt --all --manifest-path "${WORKSPACE_DIR}/Cargo.toml" -- --check; then
        fail "Formatting issues found. Run: cargo fmt --all --manifest-path tachyon/Cargo.toml"
        PASS=false
    fi

    # ---- 2. Clippy ----
    # Exclude tachyon-cli (heavy deps: wasmtime, tauri) and tachyon-testing (aggregator)
    info "Running clippy (-D warnings)..."
    if ! cargo clippy \
        --workspace \
        --exclude tachyon-cli \
        --exclude tachyon-testing \
        --exclude tachyon-benchmarks \
        --all-targets \
        --manifest-path "${WORKSPACE_DIR}/Cargo.toml" \
        -- -D warnings; then
        fail "Clippy warnings found. Run: cargo clippy --fix"
        PASS=false
    fi

    # ---- 3. Tests (library only; integration deferred to CI) ----
    info "Running library tests (--lib)..."
    if ! cargo test \
        --lib \
        --workspace \
        --exclude tachyon-cli \
        --exclude tachyon-testing \
        --exclude tachyon-benchmarks \
        --exclude tachyon-frontend \
        --manifest-path "${WORKSPACE_DIR}/Cargo.toml"; then
        fail "Tests failed. See output above for details."
        PASS=false
    fi
fi

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM)"

# ---- 4. Secret detection ----
info "Scanning for potential secrets..."
if [ -n "$STAGED_FILES" ]; then
    SECRET_HITS="$(echo "$STAGED_FILES" | grep -vE '\.githooks/|\.env\.example|\.env\.production\.example|DEVELOPER_GUIDE|getting-started|deployment|configuration' | xargs grep -lE \
        '(PASSWORD|SECRET|API_KEY|TOKEN|PRIVATE_KEY).*=.*["\x27][^"\x27]{8,}' \
        2>/dev/null || true)"
    if [ -n "$SECRET_HITS" ]; then
        fail "Potential secrets in staged files:"
        echo "$SECRET_HITS"
        PASS=false
    fi
fi

# ---- 5. Debug artifact detection ----
info "Checking for debug/build artifacts..."
if echo "$STAGED_FILES" | grep -qE '(^|/)target/|\.swp$|\.swo$|~$|\.pyc$|__pycache__|\.orig$'; then
    fail "Debug/build artifacts detected in staged files. Remove them."
    PASS=false
fi

# ---- 6. Emoji detection in documentation ----
if [ "$DOC_CHANGED" -gt 0 ]; then
    info "Checking for emojis in documentation..."
    DOC_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)"
    if [ -n "$DOC_FILES" ]; then
        EMOJI_HITS="$(echo "$DOC_FILES" | xargs grep -lP '[\x{1F600}-\x{1F64F}\x{1F300}-\x{1F5FF}\x{1F680}-\x{1F6FF}\x{1F1E0}-\x{1F1FF}\x{2600}-\x{26FF}\x{2700}-\x{27BF}]' 2>/dev/null || true)"
        if [ -n "$EMOJI_HITS" ]; then
            fail "Emojis found in documentation files:"
            echo "$EMOJI_HITS"
            PASS=false
        fi
    fi
fi

# ---- 7. Forbidden patterns in Rust code ----
if [ "$RUST_CHANGED" -gt 0 ]; then
    info "Checking for forbidden patterns in Rust code..."
    RUST_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)"
    if [ -n "$RUST_FILES" ]; then
        # Box::leak is a memory leak in production code
        LEAK_HITS="$(echo "$RUST_FILES" | xargs grep -n 'Box::leak' 2>/dev/null | grep -v '#\[cfg(test)\]' | grep -v '//' || true)"
        if [ -n "$LEAK_HITS" ]; then
            fail "Box::leak found in production code (memory leak):"
            echo "$LEAK_HITS"
            PASS=false
        fi

        # todo!() and unimplemented!() indicate incomplete features
        TODO_HITS="$(echo "$RUST_FILES" | xargs grep -nE '\b(todo!|unimplemented!)\b' 2>/dev/null | grep -v '#\[cfg(test)\]' || true)"
        if [ -n "$TODO_HITS" ]; then
            warn "todo!/unimplemented! found (may be intentional):"
            echo "$TODO_HITS"
        fi
    fi
fi

# ---- 8. Stale .specs/ references in documentation ----
if [ "$DOC_CHANGED" -gt 0 ]; then
    info "Checking for stale .specs/ references..."
    DOC_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)"
    if [ -n "$DOC_FILES" ]; then
        SPECS_HITS="$(echo "$DOC_FILES" | xargs grep -l '\.specs/' 2>/dev/null || true)"
        if [ -n "$SPECS_HITS" ]; then
            warn "Stale .specs/ references found in documentation:"
            echo "$SPECS_HITS"
        fi
    fi
fi

# ---- Result ----
if [ "$PASS" = true ]; then
    info "All pre-commit checks passed."
    exit 0
else
    fail "Pre-commit checks FAILED. Fix the issues above and re-commit."
    exit 1
fi
