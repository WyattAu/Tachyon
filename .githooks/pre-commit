#!/usr/bin/env bash
#
# Tachyon pre-commit hook
# Enforces code quality gates before any commit is created.
#
# Gates:
#   1. cargo fmt --check
#   2. cargo clippy -D warnings
#   3. cargo test --lib (library unit tests; integration tests run in CI)
#   4. cargo doc --no-deps (no warnings)
#   5. Secret detection
#   6. Debug artifact detection
#
# Install: git config core.hooksPath .githooks

REPO_ROOT="$(git rev-parse --show-toplevel)"
WORKSPACE_DIR="${REPO_ROOT}/tachyon"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}[PASS]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
fail()  { echo -e "${RED}[FAIL]${NC} $*"; }

PASS=true

# Skip checks if no Rust files were modified
RUST_CHANGED="$(git diff --cached --name-only --diff-filter=ACM | grep -cE '\.rs$|Cargo\.toml|Cargo\.lock' || true)"
if [ "$RUST_CHANGED" -eq 0 ]; then
    info "No Rust files staged. Skipping cargo checks."
    exit 0
fi

# ---- 1. Formatting ----
info "Checking formatting (cargo fmt)..."
if ! cargo fmt --all --manifest-path "${WORKSPACE_DIR}/Cargo.toml" -- --check; then
    fail "Formatting issues found. Run: cargo fmt --all --manifest-path tachyon/Cargo.toml"
    PASS=false
fi

# ---- 2. Clippy ----
info "Running clippy (-D warnings)..."
if ! cargo clippy \
    --workspace \
    --exclude tachyon-testing \
    --exclude tachyon-frontend \
    --exclude tachyon-desktop \
    --exclude tachyon-desktop-app \
    --manifest-path "${WORKSPACE_DIR}/Cargo.toml" \
    -- -D warnings; then
    fail "Clippy warnings found. Run: cargo clippy --fix"
    PASS=false
fi

# ---- 3. Tests (library only; integration tests deferred to CI) ----
info "Running library tests (--lib)..."
if ! cargo test \
    --lib \
    --workspace \
    --exclude tachyon-testing \
    --exclude tachyon-frontend \
    --exclude tachyon-desktop \
    --exclude tachyon-desktop-app \
    --manifest-path "${WORKSPACE_DIR}/Cargo.toml"; then
    fail "Tests failed. See output above for details."
    PASS=false
fi

# ---- 4. Rustdoc ----
info "Checking rustdoc..."
DOC_STDERR="$(cargo doc \
    --workspace \
    --exclude tachyon-testing \
    --exclude tachyon-frontend \
    --manifest-path "${WORKSPACE_DIR}/Cargo.toml" \
    --no-deps 2>&1 >/dev/null)" || true
if echo "$DOC_STDERR" | grep -qE "^(warning|error)"; then
    fail "Rustdoc warnings/errors found:"
    echo "$DOC_STDERR" | grep -E "^(warning|error)" | head -20
    PASS=false
fi

# ---- 5. Secret detection (exclude this hook file and .env.* templates) ----
info "Scanning for potential secrets..."
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM)"
if [ -n "$STAGED_FILES" ]; then
    SECRET_HITS="$(echo "$STAGED_FILES" | grep -vE '\.githooks/|\.env\.example|\.env\.production\.example' | xargs grep -lE \
        '(PASSWORD|SECRET|API_KEY|TOKEN|PRIVATE_KEY).*=.*["\x27][^"\x27]{8,}' \
        2>/dev/null || true)"
    if [ -n "$SECRET_HITS" ]; then
        warn "Potential secrets in staged files:"
        echo "$SECRET_HITS"
    fi
fi

# ---- 6. Debug artifact detection ----
info "Checking for debug/build artifacts..."
if echo "$STAGED_FILES" | grep -qE '(^|/)target/|\.swp$|\.swo$|~$|\.pyc$|__pycache__'; then
    fail "Debug/build artifacts detected in staged files. Remove them."
    PASS=false
fi

# ---- Result ----
if [ "$PASS" = true ]; then
    info "All pre-commit checks passed."
    exit 0
else
    fail "Pre-commit checks FAILED. Fix the issues above and re-commit."
    exit 1
fi
