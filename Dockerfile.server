# Tachyon Server Dockerfile for CachyOS deployment
FROM rust:latest AS builder

WORKDIR /build

# Copy workspace source (repo root context, workspace at tachyon/)
COPY . .

WORKDIR /build/tachyon

# Build the server binary
RUN cargo build --release -p tachyon-server 2>&1 | tail -20

# Runtime image
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 postgresql-client && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/tachyon/target/release/tachyon-server /app/tachyon-server
COPY --from=builder /build/tachyon/crates/database/migrations /app/migrations

EXPOSE 8080

CMD ["/app/tachyon-server"]
