# Tachyon Production Environment Configuration
# Copy this file to .env and update with your production values

# =============================================================================
# Server Configuration
# =============================================================================

# Server port (80 for HTTP, 443 for HTTPS behind reverse proxy)
SERVER_PORT=8080

# Server host (0.0.0.0 to listen on all interfaces)
SERVER_HOST=0.0.0.0

# Number of worker threads (auto-detected if not set)
# SERVER_WORKERS=4

# Request timeout in seconds
REQUEST_TIMEOUT=30

# =============================================================================
# Database Configuration
# =============================================================================

# SQLite database file path
DATABASE_PATH=/data/tachyon.db

# Maximum database connections
DATABASE_MAX_CONNECTIONS=100

# Connection timeout in seconds
DATABASE_CONNECTION_TIMEOUT=30

# Enable WAL mode for better concurrency (true/false)
DATABASE_ENABLE_WAL=true

# =============================================================================
# Security Configuration
# =============================================================================

# JWT secret key (generate with: openssl rand -base64 64)
# IMPORTANT: Change this in production!
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-64

# JWT token expiration in seconds (86400 = 24 hours)
JWT_EXPIRATION=86400

# Argon2 password hash cost (higher = more secure but slower)
PASSWORD_HASH_COST=12

# Maximum file upload size in bytes (10MB default)
MAX_UPLOAD_SIZE=10485760

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# =============================================================================
# Search Configuration
# =============================================================================

# Tantivy index storage path
SEARCH_INDEX_PATH=/data/search

# Maximum search results per query
SEARCH_MAX_RESULTS=1000

# Number of highlight fragments
SEARCH_HIGHLIGHT_FRAGMENTS=3

# =============================================================================
# Renderer Configuration
# =============================================================================

# Cache size for rendered documents
RENDERER_CACHE_SIZE=1000

# Enable LaTeX math rendering (true/false)
RENDERER_ENABLE_MATH=true

# Enable syntax highlighting (true/false)
RENDERER_ENABLE_SYNTAX=true

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level (error, warn, info, debug, trace)
RUST_LOG=info

# Log format (pretty, compact, json)
LOG_FORMAT=json

# =============================================================================
# Monitoring Configuration
# =============================================================================

# Enable Prometheus metrics endpoint (true/false)
METRICS_ENABLED=true

# Metrics endpoint port
METRICS_PORT=9090

# Enable health check endpoint (true/false)
HEALTH_CHECK_ENABLED=true

# =============================================================================
# Alerting Configuration
# =============================================================================

# Email for security alerts
ALERT_EMAIL=admin@example.com

# Slack webhook URL for alerts (optional)
# SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# =============================================================================
# Grafana Configuration
# =============================================================================

# Grafana admin password (change in production!)
GRAFANA_PASSWORD=admin

# =============================================================================
# Docker Compose Configuration
# =============================================================================

# Project name for Docker Compose
COMPOSE_PROJECT_NAME=tachyon-production

# Docker image version/tag
VERSION=latest

# =============================================================================
# Development/Testing (don't use in production)
# =============================================================================

# Enable debug mode (true/false) - NEVER in production
DEBUG=false

# Enable test endpoints (true/false) - NEVER in production
ENABLE_TEST_ENDPOINTS=false
