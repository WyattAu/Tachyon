# Copy to .env and customize. Only override what you need -- all vars have sensible defaults.
# Docker-compose deployment uses the service name "postgres" for the DB host.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
TACHYON_HOST=0.0.0.0
TACHYON_PORT=8080
RUST_LOG=info,tachyon_server=debug
LOG_FORMAT=text

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://tachyon:tachyon@postgres:5432/tachyon
# TACHYON_DB_MAX_CONNECTIONS=10
# TACHYON_DB_MIN_CONNECTIONS=2
# TACHYON_DB_ACQUIRE_TIMEOUT_MS=5000
# TACHYON_DB_IDLE_TIMEOUT_SECS=600

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# REQUIRED: Generate with `openssl rand -base64 48`
TACHYON_JWT_SECRET=change-me-to-a-random-48-byte-base64-string
# For secret rotation (first = current signing key, rest = legacy keys still valid for verification):
# TACHYON_JWT_SECRETS=current-secret,previous-secret
TACHYON_JWT_EXPIRATION=86400
GUEST_LOGIN_ENABLED=false
PUBLIC_NOTES_ENABLED=false

# Admin account (first-run setup)
TACHYON_ADMIN_USERNAME=admin
# TACHYON_ADMIN_PASSWORD=          # leave empty for auto-generated password
# TACHYON_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# OAuth2 (optional)
# -----------------------------------------------------------------------------
TACHYON_OAUTH2_ENABLED=false
# TACHYON_GOOGLE_CLIENT_ID=
# TACHYON_GOOGLE_CLIENT_SECRET=
# TACHYON_GITHUB_CLIENT_ID=
# TACHYON_GITHUB_CLIENT_SECRET=
# TACHYON_OAUTH2_REDIRECT_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
TACHYON_RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Redis (optional -- enables distributed rate limiting and pub/sub)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
TACHYON_SITE_TITLE=Tachyon
TACHYON_BASE_URL=http://localhost:3000
TACHYON_SITE_DESCRIPTION=A collaborative wiki

# -----------------------------------------------------------------------------
# Email / SMTP (optional)
# -----------------------------------------------------------------------------
# TACHYON_SMTP_URL=smtp://user:pass@smtp.example.com:587
# TACHYON_SMTP_FROM=noreply@tachyon.app

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Set to true when behind nginx/reverse-proxy; flip to false if serving directly in production
TACHYON_SECURITY_DEVELOPMENT=true
TACHYON_SECURITY_CSP_ENABLED=true
TACHYON_SECURITY_HSTS_ENABLED=true
# TACHYON_SECURITY_CSP_CUSTOM=
# TACHYON_SECURITY_FRAME_ANCESTORS='none'
# TACHYON_SECURITY_TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
TACHYON_FILES_ROOT=./content

# -----------------------------------------------------------------------------
# SMS OTP (optional)
# -----------------------------------------------------------------------------
# TACHYON_SMS_OTP_ENABLED=false
# TACHYON_SMS_OTP_TTL_SECS=300
# TACHYON_SMS_PROVIDER=twilio
# TACHYON_TWILIO_ACCOUNT_SID=
# TACHYON_TWILIO_AUTH_TOKEN=
# TACHYON_TWILIO_FROM_NUMBER=
# TACHYON_SMS_API_URL=

# -----------------------------------------------------------------------------
# S3 Storage (optional)
# -----------------------------------------------------------------------------
# TACHYON_STORAGE_BACKEND=s3
# TACHYON_STORAGE_S3_BUCKET=
# TACHYON_STORAGE_S3_REGION=us-east-1
# TACHYON_STORAGE_S3_ENDPOINT=
# TACHYON_STORAGE_S3_ACCESS_KEY=
# TACHYON_STORAGE_S3_SECRET_KEY=

# -----------------------------------------------------------------------------
# CDN (optional)
# -----------------------------------------------------------------------------
# TACHYON_CDN_ENABLED=false
# TACHYON_CDN_PROVIDER=
# TACHYON_CDN_BASE_URL=
# TACHYON_CDN_STATIC_TTL_SECS=3600
# TACHYON_CDN_API_TTL_SECS=60

# -----------------------------------------------------------------------------
# Read Replicas (optional)
# -----------------------------------------------------------------------------
# TACHYON_READ_REPLICA_URLS=postgres-replica1:5432,postgres-replica2:5432

# -----------------------------------------------------------------------------
# PgBouncer (optional)
# -----------------------------------------------------------------------------
# TACHYON_PGBOUNCER_ENABLED=false

# -----------------------------------------------------------------------------
# AI (optional)
# -----------------------------------------------------------------------------
# TACHYON_AI_PROVIDER=
# TACHYON_AI_API_KEY=
# TACHYON_AI_MODEL=
# TACHYON_AI_BASE_URL=
# TACHYON_AI_EMBEDDING_MODEL=
