# Docker ignore file
# Exclude unnecessary files from Docker build context

# Version control
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Documentation
*.md
docs/
LICENSE
README.md
CHANGELOG.md
CONTRIBUTING.md

# Build artifacts
target/
**/target/
**/*.rs.bk
*.pdb
dist/
**/dist/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.iml

# Environment and secrets
.env
.env.*
*.env
!.env.example
secrets/
.secrets

# Testing
**/tests/
coverage/
.coverage
*.profraw
*.profdata

# Data and logs
data/
logs/
*.log

# Docker files (prevent recursive builds)
docker-compose*.yml
.docker/
Dockerfile*

# Node modules (if any)
node_modules/

# Temporary files
tmp/
temp/
*.tmp

# Backup files
*.bak
*.backup

# OS files
Thumbs.db
Desktop.ini

# Compiled files
*.o
*.so
*.exe
*.dll
*.dylib
