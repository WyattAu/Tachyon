# Tachyon Environment Configuration
# Copy this file to .env and fill in production values
#
# ⚠️  NEVER commit .env to version control

# =============================================================================
# General
# =============================================================================

# Application version tag (used in production compose)
VERSION=latest

# Docker image registry
REGISTRY=ghcr.io
IMAGE_NAME=your-org/tachyon

# =============================================================================
# PostgreSQL
# =============================================================================

POSTGRES_USER=tachyon
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=tachyon

# =============================================================================
# Redis
# =============================================================================

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# =============================================================================
# Authentication
# =============================================================================

# JWT signing secret — MUST be at least 32 characters in production
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS

# Initial admin account (created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@tachyon.local

# =============================================================================
# Server
# =============================================================================

# Bind address and port
TACHYON_HOST=0.0.0.0
TACHYON_PORT=8080

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://tachyon.example.com

# Log level (RUST_LOG filter syntax)
RUST_LOG=tachyon_server=info,tachyon_database=info

# =============================================================================
# Files & Content
# =============================================================================

# Root directory for uploaded / managed content
TACHYON_FILES_ROOT=/app/content

# =============================================================================
# Rate Limiting
# =============================================================================

TACHYON_RATE_LIMIT_ENABLED=true
TACHYON_RATE_LIMIT_DEFAULT_RPM=100

# =============================================================================
# Optional: SMTP (uncomment to enable email)
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
# SMTP_FROM=noreply@example.com

# =============================================================================
# Optional: Monitoring
# =============================================================================
# SENTRY_DSN=https://xxx@sentry.io/xxx
