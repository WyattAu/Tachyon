# Production Environment Variables
# Copy this file to .env and fill in the values for production deployment

# PostgreSQL Configuration
POSTGRES_USER=tachyon_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=tachyon

# Redis Configuration
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT Secret for authentication
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS

# CORS Origins (comma-separated)
CORS_ORIGINS=https://tachyon.example.com,https://www.tachyon.example.com

# Docker Registry Configuration
REGISTRY=ghcr.io
IMAGE_NAME=your-org/tachyon
VERSION=latest

# Optional: External Services
# SMTP_HOST=smtp.example.com
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# Optional: Monitoring
# SENTRY_DSN=https://xxx@sentry.io/xxx
# LOG_LEVEL=info
