{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tachyon",
  "version": "0.1.0",
  "identifier": "com.tachyon.desktop",
  "build": {
    "beforeBuildCommand": "cd ../.. && cd crates/frontend && trunk build --release && ./copy-public.sh",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tachyon Knowledge Manager",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline' blob:; font-src 'self' data:; img-src 'self' data: https: http:; connect-src 'self' http://localhost:* http://127.0.0.1:* https://*.github.com https://api.github.com ipc: tauri:; frame-src 'self'; object-src 'none'; worker-src 'self' blob:; wasm-unsafe-eval",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPCONFIG/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Knowledge Management System",
    "longDescription": "Tachyon is a modern knowledge management system built for power users.",
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}