---
// SPA entry: everything renders client-side into #root (Solid app shell).
import "@/styles/global.css";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tachyon — a deterministic, high-performance knowledge management system." />
    <meta name="theme-color" content="#2563eb" />
    <title>Tachyon — Knowledge Management Platform</title>
    <script is:inline>
      // pre-paint theme: same key as lib/theme.ts (no flash of wrong theme)
      try {
        var m = localStorage.getItem("tachyon_theme") || "dark";
        var dark = m === "dark" || (m === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      } catch (e) {}
    </script>
  </head>
  <body>
    <div id="root"></div>
    <script>
      // Astro bundles this processed module script (imports resolve at build).
      import "../index";
    </script>
  </body>
</html>
