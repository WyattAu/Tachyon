DOCKER_ENV=true
COMPOSE_PROJECT_NAME=tachyon

SERVER_PORT=8080
FRONTEND_PORT=3000
SERVER_HOST=0.0.0.0
VERSION=latest

POSTGRES_USER=tachyon
POSTGRES_PASSWORD=tachyon_dev_password
POSTGRES_DB=tachyon
POSTGRES_PORT=5432

REDIS_PORT=6379

JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRATION=86400

CORS_ORIGINS=http://localhost:3000,http://localhost:8080

RUST_LOG=debug
LOG_FORMAT=pretty

DATABASE_PATH=/data/tachyon.db
SEARCH_INDEX_PATH=/data/search

RENDERER_CACHE_SIZE=100
RENDERER_ENABLE_MATH=true
RENDERER_ENABLE_SYNTAX=true

METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true
